@page "/dashboard"
@inject IProfileService ProfileService
@inject ICompanyService CompanyService
@inject IUserActivityService UserActivityService

<div class="page">
    <div class="mb-6 flex items-start justify-between gap-4">
        <div>
            <h1>Kumusta, @firstName</h1>
            <p class="text-mute">Your followed companies and contributions.</p>
        </div>
        <a class="btn btn-primary" href="companies">Find a company</a>
    </div>

    <dl class="mb-10 grid grid-cols-2 divide-x divide-line border-y border-line">
        <div class="py-4 pr-5">
            <dt class="text-[13px] text-mute">Companies followed</dt>
            <dd class="text-3xl font-bold tabular-nums text-ink">@followedCompanies.Count</dd>
        </div>
        <div class="py-4 pl-5">
            <dt class="text-[13px] text-mute">Contributions</dt>
            <dd class="text-3xl font-bold tabular-nums text-ink">@contributions.Count</dd>
        </div>
    </dl>

    <div class="grid gap-10 md:grid-cols-2">
        <section>
            <h2>Followed companies</h2>
            <ul class="rows">
                @foreach (var company in followedCompanies)
                {
                    <CompanyRow Company="company">
                        <button type="button" class="link text-danger" @onclick="() => HandleUnfollowAsync(company.Id)">Unfollow</button>
                    </CompanyRow>
                }
                @if (followedCompanies.Count == 0)
                {
                    <li class="py-4 text-mute">You are not following any companies yet. <a href="companies">Find one</a></li>
                }
            </ul>
        </section>

        <section>
            <h2>Your contributions</h2>
            <ul class="rows">
                @foreach (var contribution in contributions)
                {
                    <li class="row">
                        <div>
                            <div class="font-semibold text-ink">@contribution.Title</div>
                            <div class="text-mute">@contribution.Detail</div>
                        </div>
                    </li>
                }
            </ul>
        </section>
    </div>
</div>

@code {
    private string firstName = "";

    private IReadOnlyList<Company> followedCompanies = [];
    private IReadOnlyList<Contribution> contributions = [];

    protected override async Task OnInitializedAsync()
    {
        var profile = await ProfileService.GetProfileAsync();
        firstName = profile.DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";

        contributions = await UserActivityService.GetContributionsAsync();
        await LoadFollowedCompaniesAsync();
    }

    private async Task LoadFollowedCompaniesAsync()
    {
        var followedCompanyIds = await UserActivityService.GetFollowedCompanyIdsAsync();
        followedCompanies = await CompanyService.GetCompaniesByIdsAsync(followedCompanyIds);
    }

    private async Task HandleUnfollowAsync(int companyId)
    {
        await UserActivityService.ToggleFollowAsync(companyId);
        await LoadFollowedCompaniesAsync();
    }
}
