@page "/companies/{CompanyId:int}"
@inject ICompanyService CompanyService
@inject IUserActivityService UserActivityService

@if (isLoading)
{
    <div class="page"><p class="text-mute">Loading company.</p></div>
}
else if (company is null)
{
    <div class="page">
        <h1>Company not found</h1>
        <p class="text-mute">This company is not on Salinto yet. <a href="companies">Search companies</a></p>
    </div>
}
else
{
    <div class="page">
        <div class="flex flex-wrap items-center gap-5 pb-6">
            <span class="badge size-14 text-lg">@company.Initials</span>
            <div class="min-w-0 flex-1">
                <h1 class="!mb-0">@company.Name</h1>
                <p class="text-mute">@company.Industry. @company.Location</p>
            </div>
            <div class="grid text-right">
                <span class="text-3xl font-bold leading-none tabular-nums text-ink">@company.AverageRating.ToString("0.0")</span>
                <span class="text-mute">@company.ReviewCount reviews</span>
            </div>
            <button class="btn" type="button" aria-pressed="@isFollowing" @onclick="HandleFollowToggleAsync">@(isFollowing ? "Following" : "Follow")</button>
        </div>

        <EmploymentTypeFilter Selected="selectedEmploymentType" SelectedChanged="HandleEmploymentTypeChangedAsync" />

        <div class="grid gap-10 lg:grid-cols-[minmax(0,1.7fr)_minmax(0,1fr)]">
            <section>
                <h2>Reviews</h2>
                @foreach (var review in reviews)
                {
                    <ReviewCard Review="review" />
                }
                @if (reviews.Count == 0)
                {
                    <p class="border-t border-line py-4 text-mute">No reviews for this employment type yet. Be the first to write one.</p>
                }
                <WriteReviewForm OnSubmitted="HandleReviewSubmittedAsync" />
            </section>

            <aside>
                <h2>Monthly pay, PHP</h2>
                <ul class="rows mb-8">
                    @foreach (var entry in salaryEntries)
                    {
                        <SalaryRow Entry="entry" />
                    }
                    @if (salaryEntries.Count == 0)
                    {
                        <li class="py-4 text-mute">No salary reports for this employment type yet.</li>
                    }
                </ul>

                <h2>Labor compliance</h2>
                <p class="text-mute">Share of reviewers who report each item, based on submissions. Not an official DOLE finding.</p>
                <ul class="rows mt-3">
                    @foreach (var item in complianceItems)
                    {
                        <li class="row">
                            <div class="min-w-0 flex-1">
                                @item.Description
                                <div class="mt-1.5 h-1 rounded bg-line"><div class="h-full rounded bg-body" style="width:@(item.CompliantPercent)%"></div></div>
                            </div>
                            <span class="tabular-nums text-mute">@item.ReportedCompliantCount/@item.ReviewerCount</span>
                        </li>
                    }
                    @if (complianceItems.Count == 0)
                    {
                        <li class="py-4 text-mute">No compliance reports yet.</li>
                    }
                </ul>
            </aside>
        </div>
    </div>
}

@code {
    [Parameter] public int CompanyId { get; set; }

    private Company? company;

    private IReadOnlyList<Review> reviews = [];
    private IReadOnlyList<SalaryEntry> salaryEntries = [];
    private IReadOnlyList<ComplianceItem> complianceItems = [];

    private EmploymentType? selectedEmploymentType;

    private bool isLoading = true;
    private bool isFollowing;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        selectedEmploymentType = null;

        company = await CompanyService.GetCompanyByIdAsync(CompanyId);
        isFollowing = await UserActivityService.IsFollowingAsync(CompanyId);
        complianceItems = await CompanyService.GetComplianceItemsAsync(CompanyId);

        await LoadFilteredDataAsync();
        isLoading = false;
    }

    private async Task LoadFilteredDataAsync()
    {
        reviews = await CompanyService.GetReviewsAsync(CompanyId, selectedEmploymentType);
        salaryEntries = await CompanyService.GetSalaryEntriesAsync(CompanyId, selectedEmploymentType);
    }

    private async Task HandleEmploymentTypeChangedAsync(EmploymentType? employmentType)
    {
        selectedEmploymentType = employmentType;
        await LoadFilteredDataAsync();
    }

    private async Task HandleFollowToggleAsync()
    {
        await UserActivityService.ToggleFollowAsync(CompanyId);
        isFollowing = await UserActivityService.IsFollowingAsync(CompanyId);
    }

    private async Task HandleReviewSubmittedAsync(ReviewSubmission submission)
    {
        await CompanyService.AddReviewAsync(CompanyId, submission);

        var detail = $"{submission.Rating} of 5, {submission.EmploymentType.ToLabel().ToLower()}. {DateTime.Today:MMM d, yyyy}";
        await UserActivityService.AddContributionAsync(new Contribution($"Review of {company!.Name}", detail));

        await LoadFilteredDataAsync();
    }
}
