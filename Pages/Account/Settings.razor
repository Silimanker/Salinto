@page "/settings"

<div class="wrap narrow">
    <h1>Settings</h1>
    <p class="lede">Choose what Salinto emails you about.</p>

    <form class="form">
        <label class="check">
            <input type="checkbox" checked />
            <span>
                <span class="strong">Email me about followed companies</span>
                <span class="muted block">New reviews and salary reports for companies you follow.</span>
            </span>
        </label>
        <div class="actions"><button class="btn primary" type="button">Save settings</button></div>
    </form>
</div>
