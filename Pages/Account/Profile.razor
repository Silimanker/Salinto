@page "/profile"

<div class="wrap narrow">
    <h1>Profile</h1>
    <p class="lede">How you appear next to contributions you choose to attribute.</p>

    <form class="form">
        <div class="row2">
            <div class="field"><label for="display-name">Display name</label><input id="display-name" type="text" value="Juan Dela Cruz" /></div>
            <div class="field"><label for="location">Location</label><input id="location" type="text" value="Cebu City, Philippines" /></div>
        </div>
        <div class="field">
            <label for="bio">About your work</label>
            <textarea id="bio" rows="3">Software developer with 4 years in BPO and tech startups in Metro Cebu.</textarea>
        </div>
        <div class="actions"><button class="btn primary" type="button">Save profile</button></div>
    </form>
</div>
