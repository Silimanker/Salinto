<details class="border-t border-line pt-4">
    <summary class="mb-4 cursor-pointer font-semibold text-accent-strong">Write an anonymous review</summary>

    @if (wasPosted)
    {
        <p class="mb-4 text-sm font-semibold text-ok" role="status">Thanks, your review is posted.</p>
    }

    <EditForm Model="submission" OnValidSubmit="HandleSubmitAsync" FormName="write-review" class="grid gap-4">
        <DataAnnotationsValidator />

        <div class="grid gap-4 sm:grid-cols-3">
            <div class="grid gap-1.5">
                <label class="label" for="review-job-title">Job title</label>
                <InputText id="review-job-title" class="input" @bind-Value="submission.JobTitle" />
                <ValidationMessage For="() => submission.JobTitle" />
            </div>
            <div class="grid gap-1.5">
                <label class="label" for="review-employment-type">Employment type</label>
                <InputSelect id="review-employment-type" class="input" @bind-Value="submission.EmploymentType">
                    @foreach (var employmentType in Enum.GetValues<EmploymentType>())
                    {
                        <option value="@employmentType">@employmentType.ToLabel()</option>
                    }
                </InputSelect>
            </div>
            <div class="grid gap-1.5">
                <label class="label" for="review-rating">Rating</label>
                <InputSelect id="review-rating" class="input" @bind-Value="submission.Rating">
                    @for (var rating = 5; rating >= 1; rating--)
                    {
                        <option value="@rating">@rating out of 5</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="grid gap-1.5">
            <label class="label" for="review-body">Your review</label>
            <InputTextArea id="review-body" class="input" rows="4" @bind-Value="submission.Body"
                           placeholder="Pay on time, overtime, 13th-month pay, benefits, day-to-day work." />
            <ValidationMessage For="() => submission.Body" />
        </div>

        <div><button class="btn btn-primary">Post review</button></div>
    </EditForm>
</details>

@code {
    [Parameter] public EventCallback<ReviewSubmission> OnSubmitted { get; set; }

    private ReviewSubmission submission = new();

    private bool wasPosted;

    private async Task HandleSubmitAsync()
    {
        await OnSubmitted.InvokeAsync(submission);

        submission = new ReviewSubmission();
        wasPosted = true;
    }
}
